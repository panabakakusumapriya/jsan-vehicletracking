# ---- JSAN Tracking API : environment ----
# Copy this file to `.env` and fill real values. NEVER commit `.env`.

PORT=4000

# MongoDB Atlas. Put a FRESH password here (rotate the one that was shared in chat!).
# The /jsan_tracking segment is the database name — keep or change it.
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.okk92oh.mongodb.net/jsan_tracking?retryWrites=true&w=majority&appName=Cluster0

# Auth
JWT_SECRET=replace_with_a_long_random_string_at_least_32_chars
JWT_EXPIRES_IN=30d

# CORS is hardcoded to '*' and is no longer configurable — setting CORS_ORIGIN does nothing.

# Tracking tuning (client sends every HEARTBEAT_INTERVAL_SECONDS; server flags stale after STALE_AFTER_SECONDS)
HEARTBEAT_INTERVAL_SECONDS=10
STALE_AFTER_SECONDS=60
# An active trip silent this long is auto-closed as timed_out (app killed / long signal loss)
SESSION_DEAD_AFTER_SECONDS=900

# ---- Alerts / Web Push to the admin panel PWA ----
# Generate the keypair ONCE with `npm run vapid`, then set both values here and on the host.
# Leave them empty to run without push (the panel still shows live in-app alerts).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact address the push services can reach you at (mailto: or https:)
VAPID_SUBJECT=mailto:admin@jsan.local
# Background watchdog that raises "driver offline" alerts
ALERTS_ENABLED=true
WATCHDOG_INTERVAL_SECONDS=30
# Silence tolerated before a manager is paged. Keep well above the device's 30s stationary
# keep-alive so a red light or a tunnel never fires an alert.
DRIVER_OFFLINE_AFTER_SECONDS=180
# Follow-up notification when the driver starts reporting again
ALERT_ON_BACK_ONLINE=true

# ---- Weather (Open-Meteo + OSM Nominatim — NO API KEYS NEEDED) ----
# Forecasts: https://open-meteo.com  ·  place names: OpenStreetMap Nominatim.
# LICENSING: the free Open-Meteo endpoint is for NON-COMMERCIAL use. Their commercial plan
# runs on a different host, so switching is this one variable and no code change.
WEATHER_API_BASE=https://api.open-meteo.com
# Nominatim's usage policy requires a real identifying User-Agent, or it blocks the caller.
GEOCODER_USER_AGENT=JSAN-Fleet-Ops/1.0 (fleet ops panel)
# Cache per location. Keeps a 24-driver page load down to a couple of upstream calls.
WEATHER_CACHE_MINUTES=30
# Drivers with no trip in this many days are listed as "no recent location" rather than
# being shown the weather for a place they may have left weeks ago.
WEATHER_ACTIVE_DAYS=7
# Drivers within this many degrees (~25 km) share one forecast → one API call per depot.
WEATHER_GRID_DEGREES=0.25
# Wind thresholds in km/h, set for high-sided vans. Raise for a car-only fleet.
WEATHER_WIND_CAUTION_KMH=40
WEATHER_GUST_UNSAFE_KMH=60

# Seed account (npm run seed) — first admin login
SEED_ADMIN_NAME=Super Admin
SEED_ADMIN_EMAIL=admin@jsan.local
SEED_ADMIN_PASSWORD=Admin@12345
