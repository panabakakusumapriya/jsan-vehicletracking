    "test": "node test/integration.test.js && node test/custody.test.js && node test/tripDriverIdsFilter.test.js && node test/tripMergedSummary.test.js && node test/tripTimezoneReport.test.js && node test/tokenExpiry.test.js && node test/weather.test.js && node test/weatherPipeline.test.js && node test/hotels.test.js && node test/couriers.test.js && node test/courierLocations.test.js && node test/tzcoords.test.js && node test/mapMatch.test.js && node test/tripUkm.test.js && node test/globalUkm.test.js && node test/exportJob.test.js",
    "test:tz": "node test/tzcoords.test.js",
    "test:custody": "node test/custody.test.js",
    "test:trip-filter": "node test/tripDriverIdsFilter.test.js",
    "test:merged-summary": "node test/tripMergedSummary.test.js",
    "test:tz-report": "node test/tripTimezoneReport.test.js",
    "test:token-expiry": "node test/tokenExpiry.test.js",
    "test:weather": "node test/weather.test.js",
    "test:weather:pipeline": "node test/weatherPipeline.test.js",
    "test:hotels": "node test/hotels.test.js",
    "test:couriers": "node test/couriers.test.js",
    "test:courier-locations": "node test/courierLocations.test.js",
    "test:map-match": "node test/mapMatch.test.js",
    "test:trip-ukm": "node test/tripUkm.test.js",
    "test:global-ukm": "node test/globalUkm.test.js",
    "test:export-job": "node test/exportJob.test.js",
    "backfill:ukm": "node src/seed/backfillUkm.js",
    "backfill:global-ukm": "node src/seed/backfillGlobalUkm.js",
    "compare:ukm": "node src/seed/compareUkm.js",
    "import:couriers": "node src/seed/importCourierLocations.js",
    "indexes:prune": "node src/seed/dropRedundantIndexes.js",
    "audit:trips": "node src/seed/auditTripRows.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1121.0",
    "@aws-sdk/lib-storage": "^3.1121.0",
    "@aws-sdk/s3-request-presigner": "^3.1121.0",
    "archiver": "^7.0.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.6.0",
    "morgan": "^1.10.0",
    "multer": "^2.3.0",
    "socket.io": "^4.7.5",
    "tz-lookup": "^6.1.25",
    "web-push": "^3.6.7",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.2.0",
    "supertest": "^7.2.2"
